# App
PORT=3000

# Database (used by the app)
MYSQL_HOST=localhost
MYSQL_HOST_PORT=3306
MYSQL_USERNAME=root
MYSQL_ROOT_PASSWORD=change_this_secure_password
MYSQL_DATABASE=tshirts

# Docker ports (if you run docker-compose in stack-tshirts/)
MYSQL_CONTAINER_PORT=3306
ADMINER_CONTAINER_PORT=8080
ADMINER_HOST_PORT=8080

# Email (used by services/emailService.js)
MAIL_USER=your_gmail_or_smtp_user
MAIL_PASS=your_app_password_or_smtp_password
