header.header
    .header-left
        a.logo-home(href="/" aria-label="Ir al inicio")
            img(src="/images/logoBueno.png" alt="ByteZone" class="logo-main")

    nav.header-menu
        ul
            li: a(href="/products?category=ram") RAM
            li: a(href="/products?category=ssd") SSD
            li: a(href="/products?category=processor") Procesadores
            li: a(href="/products?category=graphics_card") Gráficas
            li: a(href="/products?category=peripherals") Periféricos
            li: a(href="/products?category=accessory") Accesorios

    .header-icons
        a(href="/profile" class="icon-group")
            img(src="/images/usrLog.png" alt="Profile" class="icon")
            span.label Perfil

        a(href="/cart" class="icon-group")
            img(src="/images/iconCart.png" alt="Cart" class="icon")
            span.label Carrito
