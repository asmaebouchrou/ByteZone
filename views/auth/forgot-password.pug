doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Recuperar contraseña - ByteZone
    link(rel="stylesheet", href="/css/auth.css")
  body
    main.auth-page
      .auth-card
        .auth-logo
          img(src="/images/logoBueno.png", alt="ByteZone")
        h1.auth-title Recupera tu contraseña
        p.auth-subtitle Te enviaremos un enlace para que puedas restablecerla.

        if error
          .alert.alert-error #{error}
        if success
          .alert.alert-success #{success}

        form.auth-form(action="/auth/forgot-password" method="post")
          .form-group
            label(for="email") Correo electrónico
            input(type="email" id="email" name="email" required autocomplete="email" placeholder="tu@correo.com")
          .form-actions
            a.forgot-link(href="/auth/login") Volver al login
            button.btn-primary(type="submit") Enviar enlace

        .auth-footer
          span ¿No tienes cuenta?
          a(href="/auth/signup") Crear cuenta
