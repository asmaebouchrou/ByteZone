doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        title register 

        h1 register 
        form(action="post" onclick="validarContrasenna()")
            input(type="text" placeholder="Full name" required)
            br
            input(type="email" placeholder="Email" required)
            br
            input(type="password" placeholder="Password" id="password"  required minlength="5")
            br
            input(type="repeat_password" placeholder="Repeat password" id="repeat_password"  required minlength="5")
            br
            button(type="submit" ) Sign up
    body 

    script 
        fuction validarContrasenna(){
            let contrasena = document.getElementById('contrasena').value;
            let contrasenaRepetida = document.getElementById('contrasenaRepetida').value;
            if (!(contrasena===contrasenaRepetida)){
                alert("Las contraseñas no coinciden, introducelas de nuevo");
                return false;
            }

        }