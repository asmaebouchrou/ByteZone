extends ../../layouts/generalLayout

block extraHead
  link(rel="stylesheet", href="/css/admin.css")

block content
  section.admin-section
    .section-header
      h1 Añadir usuario
      a.btn-secondary(href="/admin/user") Volver al listado

    form.admin-form(action="/admin/user/add" method="POST")
      .form-group
        label(for="username") Nombre de usuario
        input#username(type="text" name="username" required)

      .form-group
        label(for="email") Email
        input#email(type="email" name="email" required)

      .form-group
        label(for="role") Rol
        select#role(name="role" required)
          option(value="CLIENT" selected) Cliente
          option(value="OPERATOR") Admin

      .form-group
        label(for="password") Contraseña
        input#password(type="password" name="password" required)

      button.btn-primary(type="submit") Guardar usuario
