extends ../../layouts/generalLayout

block extraHead
  link(rel="stylesheet", href="/css/admin.css")

block content
  section.admin-section
    .section-header
      h1 Eliminar usuario
      a.btn-secondary(href="/admin/user") Volver al listado

    p ¿Seguro que deseas eliminar este usuario? Esta acción no se puede deshacer.

    table.admin-table
      tbody
        tr
          th ID
          td= user.id
        tr
          th Usuario
          td= user.username
        tr
          th Email
          td= user.email
        tr
          th Rol
          td= user.role
        tr
          th Teléfono
          td= user.phone || '-'
        tr
          th Dirección
          td= user.address || '-'

    form.form-actions(action='/admin/user/delete/' + user.id method='POST')
      button.btn-danger(type="submit") Confirmar eliminación
      a.btn-secondary(href="/admin/user") Cancelar
