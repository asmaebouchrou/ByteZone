extends ../../layouts/generalLayout

block extraHead
  link(rel="stylesheet", href="/css/admin.css")

block content
  section.admin-section
    .section-header
      h1 Añadir camiseta
      a.btn-secondary(href="/admin/tshirt") Volver al listado

    form.admin-form(action="/admin/tshirt/add" method="POST")
      .form-group
        label(for="size") Talla
        select(name="size" id="size" required)
          option(value="" disabled selected) Selecciona una talla
          option(value="xxs") XXS
          option(value="xs") XS
          option(value="s") S
          option(value="m") M
          option(value="l") L
          option(value="xl") XL
          option(value="xxl") XXL

      .form-group
        label(for="gender") Género
        select(name="gender" id="gender" required)
          option(value="" disabled selected) Selecciona género
          option(value="woman") Mujer
          option(value="man") Hombre
          option(value="unisex") Unisex
          option(value="boy") Niño
          option(value="girl") Niña
          option(value="unisex_kids") Unisex Kids

      .form-group
        label(for="color") Color
        input(type="text" name="color" id="color" placeholder="ej. rojo" required)

      .form-group
        label(for="brand") Marca
        input(type="text" name="brand" id="brand" placeholder="ej. Nike" required)

      .form-group
        label(for="stock") Stock
        input(type="number" name="stock" id="stock" min="0" value="0" max="1000" required)

      .form-group
        label(for="price") Precio (€)
        input(type="number" name="price" id="price" step="0.01" min="0" required)

      .form-group
        label(for="active") Activa
        select(name="active" id="active" required)
          option(value="1") Sí
          option(value="0") No

      .form-group
        label(for="image") URL de imagen
        input(type="text" name="image" id="image" placeholder="https://example.com/foto.jpg")

      button.btn-primary(type="submit") Guardar camiseta
