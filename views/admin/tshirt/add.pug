doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Add Tshirt
  body 
    h2 Add Tshirt

    form(action="/admin/tshirt/add" method="POST")
      .form-group
        label(for="size") Size:
        select(name="size" id="size" required)
          option(value="" disabled selected) Select a size
          option(value="xxs") XXS
          option(value="xs") XS
          option(value="s") S
          option(value="m") M
          option(value="l") L
          option(value="xl") XL
          option(value="xxl") XXL

      .form-group
        label(for="gender") Gender:
        select(name="gender" id="gender" required)
          option(value="" disabled selected) Select a gender
          option(value="woman") Woman
          option(value="man") Man
          option(value="unisex") Unisex
          option(value="boy") Boy
          option(value="girl") Girl
          option(value="unisex_kids") Unisex Kids

      .form-group
        label(for="color") Color:
        input(type="text" name="color" id="color" placeholder="e.g. red" required)

      .form-group
        label(for="brand") Brand:
        input(type="text" name="brand" id="brand" placeholder="e.g. Nike" required)

      .form-group
        label(for="stock") Stock:
        input(type="number" name="stock" id="stock" min="0" value="0" max="1000" required)

      .form-group
        label(for="price") Price (€):
        input(type="number" name="price" id="price" step="0.01" min="0" required)

      .form-group
        label(for="active") Active:
        select(name="active" id="active" required)
          option(value="1") Yes
          option(value="0") No

      .form-group
        label(for="image") Image URL:
        input(type="text" name="image" id="image" placeholder="https://example.com/photo.jpg")

      button(type="submit") Save T-Shirt
