extends ../../layouts/generalLayout

block extraHead
  link(rel="stylesheet", href="/css/admin.css")

block content
  section.admin-section
    .section-header
      h1 Editar camiseta
      a.btn-secondary(href="/admin/tshirt") Volver al listado

    form.admin-form(action='/admin/tshirt/update/' + tshirt.id method='POST')
      table.admin-table
        tbody
          tr
            th ID
            td= tshirt.id
          tr
            th Marca
            td= tshirt.brand
          tr
            th Género
            td= tshirt.gender
          tr
            th Talla
            td
              input(
                type="text"
                name="size"
                value=tshirt.size
                required
              )
          tr
            th Color
            td
              input(
                type="text"
                name="color"
                value=tshirt.color
                required
              )
          tr
            th Precio
            td
              input(
                type="number"
                name="price"
                step="0.01"
                min="0"
                value=tshirt.price
                required
              )
          tr
            th Stock
            td
              input(
                type="number"
                name="stock"
                min="0"
                value=tshirt.stock
                required
              )
      .form-actions
        a.btn-secondary(href="/admin/tshirt") Cancelar
        button.btn-primary(type="submit") Guardar cambios
