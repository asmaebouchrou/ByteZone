doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        title Delete Tshirt
    body
        h1 Delete Tshirt

        p ¿Seguro que deseas eliminar esta camiseta?

        table
            tbody
                tr
                    th ID
                    td= tshirt.id
                tr
                    th Marca
                    td= tshirt.brand
                tr
                    th Género
                    td= tshirt.gender
                tr
                    th Talla
                    td= tshirt.size
                tr
                    th Color
                    td= tshirt.color
                tr
                    th Precio
                    td= tshirt.price
                tr
                    th Stock
                    td= tshirt.stock

        form(action='/admin/tshirt/delete/' + tshirt.id method='POST')
            button(type="submit") Confirmar eliminación
            a(href="/admin/tshirt")
                button(type="button") Cancelar
