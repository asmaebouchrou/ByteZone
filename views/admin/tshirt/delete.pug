extends ../../layouts/generalLayout

block extraHead
  link(rel="stylesheet", href="/css/admin.css")

block content
  section.admin-section
    .section-header
      h1 Eliminar camiseta
      a.btn-secondary(href="/admin/tshirt") Volver al listado

    p ¿Seguro que deseas eliminar esta camiseta? Esta acción no se puede deshacer.

    table.admin-table
      tbody
        tr
          th ID
          td= tshirt.id
        tr
          th Marca
          td= tshirt.brand
        tr
          th Género
          td= tshirt.gender
        tr
          th Talla
          td= tshirt.size
        tr
          th Color
          td= tshirt.color
        tr
          th Precio
          td= tshirt.price
        tr
          th Stock
          td= tshirt.stock

    form.form-actions(action='/admin/tshirt/delete/' + tshirt.id method='POST')
      button.btn-danger(type="submit") Confirmar eliminación
      a.btn-secondary(href="/admin/tshirt") Cancelar
