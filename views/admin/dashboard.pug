extends ../layouts/generalLayout

block extraHead
  link(rel="stylesheet", href="/css/admin.css")

block content
  .admin-dashboard
    h1 Panel de administración
    p Administra inventario y equipo desde un solo lugar.

    .admin-dashboard__grid
      .admin-card
        h2 Productos
        p Revisa el catálogo, edita o elimina componentes.
        a.btn-primary(href="/admin/products") Ir a productos

      .admin-card
        h2 Usuarios
        p Gestiona operadores y clientes registrados.
        a.btn-secondary(href="/admin/user") Ir a usuarios
