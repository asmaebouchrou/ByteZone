extends ../../layouts/generalLayout.pug

block extraHead
  link(rel="stylesheet", href="/css/tshirt.css")

block content
  .tshirt-detail
    each camiseta in detalle
      .detail-card
        .detail-image
          img(src=camiseta.image || "/images/tshirt_example.jpg", alt=camiseta.brand || "Camiseta")
        .detail-info
          h1= camiseta.brand || 'Camiseta'
          p.detail-meta #{camiseta.gender || 'Unisex'} · #{camiseta.size || 'Talla única'}
          - const priceValue = typeof camiseta.price === 'number' ? `${camiseta.price.toFixed(2)} €` : (camiseta.price ? `${camiseta.price} €` : 'Próximamente')
          p.detail-price #{priceValue}
          p.detail-stock Stock: #{camiseta.stock || '—'}
          .detail-actions
            a.btn-primary(href=`/cart/add/tshirt/${camiseta.id}`) Añadir al carrito
            a.btn-secondary(href="/tshirt") Seguir comprando
          p.detail-category Categoría: T-Shirts
