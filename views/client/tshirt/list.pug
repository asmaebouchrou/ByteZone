doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        title List-T-Shirts
        style.
            .grid {
                display: flex;
                flex-wrap: wrap;
                gap: 20px;
                width: 90%;
                margin: 20px auto;
            }
            .card {
                width: calc(33.33% - 20px);
                border: 1px solid #ddd;
                padding: 0px;
                text-align: center;
            }
            .card img {
                width: 60%;
                height: auto;
            }
    body
        div.grid
            // Fila 1
            each item in [1,2,3]
                div.card
                    img(src="/images/tshirt_example.jpg", alt="")
                    p Nombre: Camiseta #{item}
                    p Precio: #{item * 10}€
                    a(href=`/tshirts/${item}`) 
                        button Ver Detalle

            // Fila 2
            each item in [4,5,6]
                div.card
                    img(src="/images/tshirt_example.jpg", alt="")
                    p Nombre: Camiseta #{item}
                    p Precio: #{item * 10}€
                    button Ver Detalle

            // Fila 3
            each item in [7,8,9]
                div.card
                    img(src="/images/tshirt_example.jpg", alt="")
                    p Nombre: Camiseta #{item}
                    p Precio: #{item * 10}€
                    button Ver Detalle

            // Fila 4
            each item in [10,11,12]
                div.card
                    img(src="/images/tshirt_example.jpg", alt="")
                    p Nombre: Camiseta #{item}
                    p Precio: #{item * 10}€
                    a(href="") 
                        button Ver Detalle
            
            //Fila de camisetas de la base de datos
            each camiseta in tshirts
                div.card
                    img(src=camiseta.image, alt="")
                    p= camiseta.size
                    p= camiseta.price
                    p= camiseta.gender
                    p= camiseta.brand
                    a(href=`/tshirt/${camiseta.id}`) 
                        button Ver Detalle