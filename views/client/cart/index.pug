extends ../../layouts/generalLayout

block content
    .cart-container
        h1 Shopping Cart

        if items.length === 0
            p Your cart is empty.
            a(href="/tshirt" class="btn btn-primary") View products
        else
            table.cart-table
                thead
                    tr
                        th Product
                        th Color
                        th Size
                        th Quantity
                        th Price
                        th Subtotal
                        th Actions

                tbody
                    each item in items
                        tr
                            td #{item.brand}
                            td #{item.color}
                            td #{item.size}

                            // Quantity with + and -
                            td
                                a.btn-minus(href=`/cart/del/tshirt/${item.id}`) −
                                span.qty #{item.quantity}
                                a.btn-plus(href=`/cart/add/tshirt/${item.product}`) +

                            td #{item.sale_price.toFixed(2)} €
                            td #{(item.sale_price * item.quantity).toFixed(2)} €

                            td
                                a.btn-delete(href=`/cart/del/tshirt/${item.id}?full=1`) 🗑️

            .cart-total
                h2 Total: #{cart.total.toFixed(2)} €

            .actions
                a(
                    href="/cart/checkout"
                    class="btn btn-success"
                ) Checkout
