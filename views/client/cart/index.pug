extends ../../layouts/generalLayout

block content
    .cart-container
        h1 Carrito de Compra

        if items.length === 0
            p Tu carrito está vacío.
            a(href="/tshirt" class="btn btn-primary") Ver productos
        else
            table.cart-table
                thead
                    tr
                        th Producto
                        th Color
                        th Talla
                        th Cantidad
                        th Precio
                        th Subtotal
                        th Acciones

                tbody
                    each item in items
                        tr
                            td #{item.brand}
                            td #{item.color}
                            td #{item.size}

                            // Cantidad con botones + y -
                            td
                                a.btn-minus(href=`/cart/del/tshirt/${item.id}`) −
                                span.qty #{item.quantity}
                                a.btn-plus(href=`/cart/add/tshirt/${item.product}`) +

                            td #{item.sale_price.toFixed(2)} €
                            td #{(item.sale_price * item.quantity).toFixed(2)} €

                            td
                                a.btn-delete(href=`/cart/del/tshirt/${item.id}?full=1`) 🗑️

            .cart-total
                h2 Total: #{cart.total.toFixed(2)} €

            .actions
                a(
                    href="/cart/checkout"
                    class="btn btn-success"
                ) Procesar compra