extends ../layouts/generalLayout.pug

block extraHead
  link(rel="stylesheet", href="/css/profile.css")

block content
  .profile-page
    .profile-header
      .profile-heading
        h1 Tu perfil
        p Mantén tus datos al día y protege tu cuenta.
      a.logout-link(href="/auth/logout") Cerrar sesión

    if success
      .alert.alert-success #{success}
    if error
      .alert.alert-error #{error}

    .profile-grid
      .profile-card.profile-summary
        h2 Resumen de cuenta
        .summary-list
          .summary-item
            span.label Nombre
            span.value #{user.username}
          .summary-item
            span.label Correo
            span.value #{user.email}
          .summary-item
            span.label Rol
            span.value #{user.role}

      .profile-card
        h2 Actualizar datos
        p.card-subtitle Edita tu correo, teléfono o dirección.
        form.profile-form(action="/profile/update" method="post")
          .form-group
            label(for="phone") Teléfono
            input(type="text" name="phone" id="phone" value=user.phone placeholder="+34 600 000 000" autocomplete="tel")
          .form-group
            label(for="address") Dirección
            input(type="text" name="address" id="address" value=user.address placeholder="Calle, número, ciudad" autocomplete="street-address")
          .form-group
            label(for="email") Correo electrónico
            input(type="email" name="email" id="email" value=user.email placeholder="tu@correo.com" autocomplete="email")
          button.btn-primary(type="submit") Guardar cambios

      .profile-card
        h2 Seguridad
        p.card-subtitle Cambia tu contraseña para mantener la cuenta segura.
        form.profile-form(action="/profile/change-password" method="post")
          .form-group
            label(for="currentPassword") Contraseña actual
            input(type="password" name="currentPassword" id="currentPassword" required autocomplete="current-password")
          .form-group
            label(for="newPassword") Nueva contraseña
            input(type="password" name="newPassword" id="newPassword" required autocomplete="new-password")
          .form-group
            label(for="confirmNewPassword") Confirmar nueva contraseña
            input(type="password" name="confirmNewPassword" id="confirmNewPassword" required autocomplete="new-password")
          button.btn-primary(type="submit") Actualizar contraseña

    .profile-actions
      a.btn-secondary(href="/orders") Ver mis pedidos
