extends ../../layouts/generalLayout

block content
    h1 Order Details ##{order.id}

    p 
        strong Date: 
        | #{order.date.toLocaleDateString()}

    p 
        strong Status: 
        | #{order.status}

    h2 Order Items

    table
        thead
            tr
                th Product
                th Color
                th Size
                th Quantity
                th Price
                th Subtotal
        tbody
            each item in items
                tr
                    td= item.brand
                    td= item.color
                    td= item.size
                    td= item.quantity
                    td= (parseFloat(item.sale_price) || 0).toFixed(2) + " €"
                    td= ((parseFloat(item.sale_price) || 0) * (item.quantity || 0)).toFixed(2) + " €"

    h2 Total: #{(parseFloat(order.total) || 0).toFixed(2)} €

    a.btn(href="/orders") Back to Orders List
