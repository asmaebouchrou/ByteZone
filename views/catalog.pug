extends ../layouts/generalLayout.pug

block content
  section
    form(action="/camiseta" method="get")
      div
        label(for="color") Color:
        select(name="color" id="color")
          option(value="") Todos
          option(value="negro") Negro
          option(value="blanco") Blanco
          option(value="rojo") Rojo
          option(value="azul") Azul
          option(value="verde") Verde

      div
        label(for="marca") Marca:
        select(name="marca" id="marca")
          option(value="") Todas
          option(value="Nike") Nike
          option(value="Adidas") Adidas
          option(value="Puma") Puma
          option(value="Under Armour") Under Armour
          option(value="New Balance") New Balance
          option(value="Champion") Champion

      div
        label(for="precioMin") Precio mínimo:
        input(type="number" name="precioMin" id="precioMin" min="0")

      div
        label(for="precioMax") Precio máximo:
        input(type="number" name="precioMax" id="precioMax" min="0")

      div
        button(type="submit") Filtrar


  section
    h2 Catálogo de camisetas
    div(style="display:grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-top:1rem;")
      each camiseta in camisetas
        a(href=`/camiseta/${camiseta.id}`, style="text-align:center; text-decoration:none; color:inherit;")
          img(src=camiseta.imagen alt=camiseta.marca style="width:100%; height:auto; border:1px solid #ccc; border-radius:4px;")
          p #{camiseta.marca} - #{camiseta.color} (#{camiseta.precio}€)

  nav(style="text-align:center; margin-top:2rem;")
    ul(style="list-style:none; display:inline-flex; gap:0.5rem; padding:0;")
      li
        a(href="?page=#{paginaActual - 1}" style=paginaActual == 1 ? "pointer-events:none; color:#aaa;" : "") ←
      each num in paginas
        li
          if num == paginaActual
            span(style="font-weight:bold; text-decoration:underline;") #{num}
          else
            a(href=`?page=${num}`) #{num}
      li
        a(href="?page=#{paginaActual + 1}" style=paginaActual == paginas.length ? "pointer-events:none; color:#aaa;" : "") →
